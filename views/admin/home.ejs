            <!-- BUSES & SEATS TAB -->
            <div id="buses" class="tab-content">
                <h2><i class="fas fa-box"></i> Buses & Seats</h2>
                <div class="grid-2">
                    <div class="card">
                        <form id="busForm" action="#" method="POST">
                            <h3><i class="fas fa-package"></i> Bus Details (1)</h3>
                            <div class="form-group">
                                <label>Bus Plate Number</label>
                                <input type="text" id="plateNumber" placeholder="Bus Plate Number">
                            </div>
                            <div class="form-group">
                                <label>Bus Capacity</label>
                                <input type="number" id="Capacity" placeholder="Bus Capacity">
                            </div>
                            <div class="form-group">
                                <label>Bus Type</label>
                                <select  id="bus_type">
                                    <option value="">Choose Bus Type</option>
                                    <option value="City Transit Bus">City Transit Bus</option>
                                    <option value="Minibus">Minibus</option>
                                    <option value="Shuttle Bus">Shuttle Bus</option>
                                    <option value="Coach Bus">Coach Bus</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Bus Driver</label>
                                <select id="bus_driver">
                                    <option value="">Choose Bus Driver</option>
                                    <option value="Mr. John Doe">Mr. John Doe</option>
                                    <option value="Mr. Tom Brad">Mr. Tom Brad</option>
                                    <option value="Mr. Omollo">Mr. Omollo</option>
                                    <option value="Mr. Patrick">Mr. Patrick</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Bus Name</label>
                                <select id="bus_name">
                                    <option value="">Choose Bus Name</option>
                                    <option value="Bus A">Bus A</option>
                                    <option value="Bus B">Bus B</option>
                                    <option value="Bus C">Bus C</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Travel Session (Time)</label>
                                <select id="bus_session">
                                    <option value="">Choose Bus Travel Session</option>
                                    <option value="morning">Morining (4:00 - 9:00) AM</option>
                                    <option value="evening">Evening (4:00 - 8:00) PM</option>
                                </select>
                            </div>
                            <button type="submit" id="addBus" class="btn-primary"><i class="fas fa-plus-circle"></i> Register Bus</button>
                        </form>
                    </div>
                    <div class="card">
                        <form id="addSeat" action="#" method="POST">
                            <h3><i class="fas fa-package"></i> Seats Details (2)</h3>
                            <div class="form-group">
                                <label>Bus Plate Number</label>
                                <input type="text" id="Bus_plate" placeholder="Bus Plate Number">
                            </div>
                            <div class="form-group">
                                <label>Bus Seats Number</label>
                                <select  id="seats_number">
                                    <option value="">Choose Seat Number</option>
                                    <option value="1">Seat 1</option>
                                    <option value="2">Seat 2</option>
                                    <option value="3">Seat 3</option>
                                    <option value="4">Seat 4</option>
                                    <option value="5">Seat 5</option>
                                    <option value="6">Seat 6</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Seat Class (Type)</label>
                                <select  id="category">
                                    <option value="">Choose Seat Type</option>
                                    <option value="First Class">First Class (VIP)</option>
                                    <option value="Middle Class">Middle Class</option>
                                    <option value="Economy">Economy Class</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Seat Price (Cost)</label>
                                <select  id="seat_price">
                                    <option value="">Choose Seat Price</option>
                                    <option value="5000">UGX 5000 (First Class)</option>
                                    <option value="2500">UGX 2500 (Middle class)</option>
                                    <option value="1000">UGX 1000 (Economy Class)</option>
                                </select>
                            </div>
                            <button id="seatBtn" class="btn-primary" style="float: right;"><i class="fas fa-plus-circle"></i> Register Seat</button>
                        </form>
                    </div>
                </div>
                <div class="contact-info">
                    <h3><i class="fas fa-truck"></i> Buses & Routes Support</h3>
                    <p><i class="fas fa-phone"></i> +256 753 682 216</p>
                    <p><i class="fas fa-envelope"></i> buses&routesgistics@mobus.africa</p>
                </div>
            </div>

