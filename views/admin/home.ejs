        </div>
    </header>

    <div class="container" id="appContainer">
        <!--  -->

        <!-- Tabs -->
        <div class="tab-container">
            <div class="tabs" id="tabHeaders">
                <div class="tab active" onclick="switchTab('daily')"><i class="fas fa-briefcase"></i> Dashboard</div>
                <div class="tab" onclick="switchTab('buses')"><i class="fas fa-bus"></i> Buses & Seats</div>
                <div class="tab" onclick="switchTab('trips')"><i class="fas fa-globe-africa"></i> Trips & Routes</div>
                <div class="tab" onclick="switchTab('wallet')"><i class="fas fa-dollar-sign"></i> Revenue / Income</div>
            </div>

            <!-- DAILY TAB -->
            <div id="daily" class="tab-content active">
                <h2><i class="fas fa-briefcase"></i> Daily Commute</h2>
                
                <!-- Stats -->
                <div class="stats-grid" id="statsGrid">
                    <div class="stat-card"><i class="fas fa-ticket-alt"></i><div class="number" id="totalBookings">0</div><div class="label">Total Bookings</div></div>
