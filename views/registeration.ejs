<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
  <title>MoBus Africa · Resgistration</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="css/registration.css" />
  <link rel="shortcut icon" href="img/favicon.ico" type="image/x-icon">
</head>
<body>

<!-- header -->
<header>
  <div class="logo"><i class="fas fa-bus"></i><span>MoBus</span></div>
  <div class="nav-buttons">
    <a href="/" class="nav-btn primary"><i class="fas fa-home"></i> Home</a>
    <a href="/help" class="nav-btn secondary"><i class="fas fa-headset"></i> Help</a>
    <a href="/ai" class="nav-btn accent"><i class="fas fa-robot"></i> AI</a>
  </div>
</header>

<div class="container">


  <!-- notification -->
  <div class="notification" id="notification">
    <i class="fas fa-check-circle"></i>
    <span id="notificationText">Welcome back!</span>
  </div>

  <div class="auth-card">
    <!-- Tabs -->
    <div class="auth-tabs">
      <button class="auth-tab" data-tab="signup">
        <i class="fas fa-user-plus"></i> Sign Up
      </button>
    </div>

    <!-- SIGN UP FORM -->
    <div id="signupForm" class="auth-form active">
      <form id="sign_Up_Form" action="#" method="POST" enctype="application/x-www-form-urlencoded">
        <div class="form-row">
          <div class="form-group">
            <label><i class="fas fa-user"></i> First Name</label>
            <input type="text" name="first_name" id="signupFirst" placeholder="First name"  />
          </div>
          <div class="form-group">
            <label><i class="fas fa-user"></i> Last Name</label>
            <input type="text" name="last_name" id="signupLast" placeholder="Last name"  />
          </div>
        </div>
        <div class="form-group">
          <label><i class="fas fa-envelope"></i> Email Address</label>
          <input type="email" name="email" id="signupEmail" placeholder="you@example.com"  />
        </div>
        <div class="form-group">
          <label><i class="fas fa-phone"></i> Phone Number</label>
          <input type="tel" name="phone" id="signupPhone" placeholder="+256 700 000 000" />
        </div>
        <div class="form-group">
          <label><i class="fas fa-lock"></i> Password</label>
          <input type="password" name="password" id="signupPassword" placeholder="Min 8 characters"  minlength="8" />
        </div>
        <div class="form-group">
          <label><i class="fas fa-check-circle"></i> Confirm Password</label>
          <input type="password" name="confirm_password" id="signupConfirm" placeholder="Confirm password"  />
          <i id="showpass" class="fas fa-eye"></i> <i id="hidepass" class="fa fa-eye-slash"></i>
        </div>
        <div class="checkbox-group">
          <input type="checkbox" id="termsCheck"  />
          <label for="termsCheck">I agree to the <a href="#" style="color:var(--primary);">Terms & Conditions</a> and <a href="#" onclick="showNotification('🔒 Privacy Policy'); return false;" style="color:var(--primary);">Privacy Policy</a></label>
        </div>
        <button type="submit" id="signupbtn" class="btn btn-secondary" ><i class="fas fa-user-plus"></i> Create Account</button>
        <div class="auth-footer">
          Already have an account? <a href="/login">Login</a>
        </div>
        <div class="divider">or sign up with</div>
        <div class="social-login">
          <button type="button" class="social-btn google"><i class="fab fa-google"></i> Google</button>
          <button type="button" class="social-btn facebook"><i class="fab fa-facebook"></i> Facebook</button>
        </div>
      </form>
    </div>
  </div>

  <!-- back to home link -->
  <div style="text-align: center; margin-top: 8px;">
    <a href="/" onclick="showNotification('🏠 Returning to homepage');" style="color: var(--primary); font-weight: 600; text-decoration: none; font-size: 0.9rem;">
      <i class="fas fa-arrow-left"></i> Back to Home
    </a>
  </div>
</div>

<!-- footer -->
<footer>
  <div class="footer-inner">
    <p>MoBus Africa &copy; 2024 · Secure · Fast · Reliable</p>
    <p style="margin-top: 4px;"><a href="#" onclick="showNotification('🔒 Privacy'); return false;">Privacy</a> · <a href="#" onclick="showNotification('📜 Terms'); return false;">Terms</a> · <a href="#" onclick="showNotification('📧 support@mobus.africa'); return false;">Support</a></p>
  </div>
</footer>

<script src="js/registration.js"></script>
</body>
</html>